{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/dbInit.ts",
    "db:seed": "tsx src/seed/seed.ts",
    "db:reset": "tsx src/scripts/dbReset.ts",
    "db:verify": "tsx src/scripts/dbVerify.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
